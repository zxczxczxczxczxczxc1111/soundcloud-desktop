{
    "name": "soundcloud-desktop",
    "version": "0.1.0",
    "description": "Клиент SoundCloud для Windows",
    "author": {
        "name": "Richard Habitzreuter",
        "email": "richardhabitzreuter@icloud.com"
    },
    "license": "MIT",
    "scripts": {
        "lint": "eslint src",
        "test": "vitest run",
        "test:watch": "vitest",
        "copy-header": "cpx \"src/header/**/*\" tsc/header",
        "dev": "tsc && npm run copy-header && electron ./tsc/main.js --dev",
        "build": "tsc && npm run copy-header && electron-builder --dir",
        "build-win": "tsc && npm run copy-header && electron-builder -w nsis",
        "build-win-ptb": "tsc && npm run copy-header && electron-builder -w portable",
        "build-mac": "tsc && npm run copy-header && electron-builder -m dmg",
        "build-linux-deb": "tsc && npm run copy-header && electron-builder -l deb",
        "build-linux-appimage": "tsc && npm run copy-header && electron-builder -l appimage",
        "typecheck": "tsc --noEmit",
        "postinstall": "node node_modules/electron/install.js"
    },
    "main": "./tsc/main.js",
    "repository": "https://github.com/zxczxczxczxczxczxc1111/soundcloud-desktop",
    "build": {
        "appId": "io.github.zxczxczxczxczxczxc1111.soundcloud-desktop",
        "productName": "SoundCloud Desktop",
        "asar": true,
        "extraResources": [
            {
                "from": "assets/icons",
                "to": "assets/icons"
            }
        ],
        "files": [
            "tsc/**/*",
            "!node_modules/electron/**/*"
        ],
        "directories": {
            "buildResources": "build-resources",
            "output": "build"
        },
        "electronDownload": {
            "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
        },
        "afterSign": "scripts/sign-vmp.js",
        "mac": {
            "target": "dmg",
            "icon": "assets/icons/soundcloud-mac.icns",
            "artifactName": "soundcloud-${version}-mac.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build-resources/entitlements.mac.plist",
            "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist"
        },
        "win": {
            "target": "nsis",
            "icon": "assets/icons/soundcloud-win.ico",
            "artifactName": "soundcloud-desktop-${version}-setup-${arch}.${ext}"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "assets/icons/soundcloud.png",
            "category": "AudioVideo",
            "executableName": "soundcloud-rpc",
            "synopsis": "SoundCloud client with Discord Rich Presence",
            "artifactName": "soundcloud-${version}-linux.${ext}",
            "desktop": {
                "entry": {
                    "Name": "SoundCloud",
                    "Comment": "SoundCloud client with Discord Rich Presence",
                    "Categories": "AudioVideo;Audio;Music;",
                    "StartupWMClass": "soundcloud-rpc"
                }
            }
        },
        "portable": {
            "artifactName": "soundcloud-desktop-${version}-portable-${arch}.${ext}"
        }
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.37.0",
        "@types/node": "^24.2.1",
        "@types/semver": "^7.5.8",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "cpx": "^1.5.0",
        "electron": "https://github.com/castlabs/electron-releases#v41.1.1+wvcus",
        "electron-builder": "^26.7.0",
        "eslint": "^9.33.0",
        "prettier": "3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.46.0",
        "vitest": "^3.1.3"
    },
    "dependencies": {
        "@ghostery/adblocker-electron": "^2.11.3",
        "@xhayper/discord-rpc": "^1.3.0",
        "cross-fetch": "^4.0.0",
        "discord-api-types": "^0.38.18",
        "electron-prompt": "^1.7.0",
        "electron-store": "^8.1.0",
        "electron-window-state": "^5.0.3"
    },
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=24 <25"
    }
}
