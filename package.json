{
    "name": "soundcloud-desktop",
    "version": "0.16.0",
    "description": "Клиент SoundCloud для Windows",
    "author": {
        "name": "zxczxczxczxczxczxc1111",
        "email": "196401605+zxczxczxczxczxczxc1111@users.noreply.github.com"
    },
    "license": "MIT",
    "scripts": {
        "lint": "eslint src",
        "test": "vitest run",
        "test:watch": "vitest",
        "copy-header": "node scripts/copy-static.cjs",
        "dev": "tsc && node scripts/build-info.cjs && npm run copy-header && electron ./tsc/main.js --dev",
        "build": "node scripts/clean-tsc.cjs && tsc && node scripts/build-info.cjs && npm run copy-header && electron-builder --publish never --dir",
        "build-win": "node scripts/clean-tsc.cjs && tsc && node scripts/build-info.cjs && npm run copy-header && electron-builder --publish never -w nsis",
        "build-mac": "node scripts/clean-tsc.cjs && tsc && node scripts/build-info.cjs && npm run copy-header && electron-builder --publish never -m dmg",
        "build-linux-deb": "node scripts/clean-tsc.cjs && tsc && node scripts/build-info.cjs && npm run copy-header && electron-builder --publish never -l deb",
        "build-linux-appimage": "node scripts/clean-tsc.cjs && tsc && node scripts/build-info.cjs && npm run copy-header && electron-builder --publish never -l appimage",
        "typecheck": "tsc --noEmit",
        "postinstall": "node node_modules/electron/install.js",
        "test:electron": "tsc && node scripts/build-info.cjs && npm run copy-header && node scripts/check-page-names.cjs && node scripts/run-electron.cjs",
        "check:page": "tsc && node scripts/check-page-names.cjs",
        "check:repo": "node scripts/check-repo.cjs"
    },
    "main": "./tsc/main.js",
    "repository": "https://github.com/zxczxczxczxczxczxc1111/soundcloud-desktop",
    "build": {
        "appId": "io.github.zxczxczxczxczxczxc1111.soundcloud-desktop",
        "productName": "SoundCloud",
        "asar": true,
        "extraResources": [
            {
                "from": "assets/icons",
                "to": "assets/icons"
            }
        ],
        "files": [
            "tsc/**/*",
            "!node_modules/electron/**/*",
            "!tsc/**/*.test.js",
            "!tsc/**/*.test.js.map",
            "!tsc/**/*.map"
        ],
        "directories": {
            "buildResources": "build-resources",
            "output": "build"
        },
        "electronDownload": {
            "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
        },
        "afterSign": "scripts/sign-vmp.js",
        "publish": {
            "provider": "github",
            "owner": "zxczxczxczxczxczxc1111",
            "repo": "soundcloud-desktop"
        },
        "mac": {
            "target": "dmg",
            "icon": "assets/icons/soundcloud-mac.icns",
            "artifactName": "soundcloud-${version}-mac.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build-resources/entitlements.mac.plist",
            "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist"
        },
        "win": {
            "target": "nsis",
            "icon": "assets/icons/soundcloud-win.ico",
            "artifactName": "soundcloud-desktop-${version}-setup-${arch}.${ext}"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "assets/icons/soundcloud.png",
            "category": "AudioVideo",
            "executableName": "soundcloud-rpc",
            "synopsis": "SoundCloud client with Discord Rich Presence",
            "artifactName": "soundcloud-${version}-linux.${ext}",
            "desktop": {
                "entry": {
                    "Name": "SoundCloud",
                    "Comment": "SoundCloud client with Discord Rich Presence",
                    "Categories": "AudioVideo;Audio;Music;",
                    "StartupWMClass": "soundcloud-rpc"
                }
            }
        },
        "nsis": {
            "include": "build-resources/installer.nsh"
        }
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@types/jsdom": "30.0.0",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "electron": "github:castlabs/electron-releases#v43.8.3+wvcus",
        "electron-builder": "^26.18.0",
        "eslint": "^10.13.0",
        "jsdom": "30.1.3",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@ghostery/adblocker-electron": "^2.20.1",
        "@xhayper/discord-rpc": "^1.5.1",
        "discord-api-types": "^0.38.57",
        "electron-store": "^12.0.0",
        "electron-updater": "6.8.11",
        "electron-window-state": "^5.0.3",
        "koffi": "3.3.4",
        "ms": "2.1.3"
    },
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=24 <25"
    }
}
